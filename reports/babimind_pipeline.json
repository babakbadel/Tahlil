          "q1_operating_revenue_growth_yoy_pct": 183,
          "q1_gross_profit_growth_yoy_pct": 247,
          "price_1405_06_04_rial": 19950
        },
        "hidden_signal": {
          "name": "volume_quality_not_price_headline",
          "logic": "Prioritize sales-volume effect over headline copper-price narratives. If revenue accelerates while volume contribution dominates, the thesis is stronger and less dependent on a single commodity-price spike.",
          "confirmation": [
            "monthly sales keeps setting higher highs",
            "production/sales volume remains firm",
            "realized copper price stays supportive",
            "market share/leadership persists",
            "price advances with improving turnover rather than only gap-up behavior"
          ],
          "invalidation": [
            "sales growth rolls over for two consecutive releases",
            "volume falls while revenue is supported only by price",
            "copper price breaks down materially and remains weak",
            "stock leadership disappears while market breadth remains healthy"
          ]
        },
        "event_chain": [
          "global copper supply disruption or tightness",
          "higher copper benchmark",
          "higher realized sales price / margins",
          "higher FMLI earnings expectations",
          "fund-flow rotation toward large liquid commodity leaders",
          "technical breakout or continuation",
          "option convexity increases demand for calls"
        ],
        "scenario_weights": {
